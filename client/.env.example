# Backend sunucusunun KOK adresi. Sadece bu satiri degistirmen yeterli.
#
# Kodda istekler soyle yapiliyor:  fetch(`${API_BASE}/api/auth/login`)
# Yani "/api/..." kismini kod ekliyor, buraya YAZMA:
#
#   VITE_API_BASE_URL=http://localhost:5000       -> http://localhost:5000/api/auth/login      (dogru)
#   VITE_API_BASE_URL=http://localhost:5000/api   -> http://localhost:5000/api/api/auth/login  (yanlis, 404)
#
# Deploy ornegi: VITE_API_BASE_URL=https://api.siteadresiniz.com
VITE_API_BASE_URL=http://localhost:5000
