# TaskiFlow backend ortam değişkenleri.
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun. .env asla commit edilmez.

# --- Zorunlu ---

# PostgreSQL bağlantısı (Prisma bunu kullanır).
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/postgres"

# JWT imzalama anahtarı. Rastgele ve uzun olmalı, örn:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Frontend adresi. İki yerde kullanılır:
#   1) CORS whitelist (server.js)
#   2) Ödeme sonrası tarayıcı yönlendirmesi (paymentController.js)
# Birden fazla adres virgülle ayrılabilir; yönlendirme için ilki kullanılır.
FRONTEND_URL="http://localhost:5173"

# --- Ödeme (iyzico) ---
# Bu değerler eksikse ödeme uçları 503 döner; sunucunun geri kalanı çalışmaya
# devam eder.

IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# 3D Secure doğrulaması bittiğinde iyzico'nun POST ettiği adres.
# Sunucuya dışarıdan erişilebilen tam URL olmalı (yerelde ngrok vb.).
# Boş bırakılırsa iyzico 3DS başlatma isteğini reddeder.
IYZICO_CALLBACK_URL="http://localhost:5000/api/payments/complete-3ds"

# --- AI (şu an devre dışı) ---
# aiRoutes/chatRoutes server.js'e bağlı değil ve @google/generative-ai paketi
# kurulu değil. Özellik aktifleştirilirse bu anahtar gerekir.
GEMINI_API_KEY=""
